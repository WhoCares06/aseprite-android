<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="General">
        <SwitchPreferenceCompat
            android:key="dark_mode"
            android:title="Dark Mode"
            android:summary="Use dark theme"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="auto_save"
            android:title="Auto Save"
            android:summary="Automatically save changes"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Editor">
        <ListPreference
            android:key="default_color_mode"
            android:title="Default Color Mode"
            android:summary="Color mode for new sprites"
            android:entries="@array/color_mode_entries"
            android:entryValues="@array/color_mode_values"
            android:defaultValue="0" />
        <EditTextPreference
            android:key="default_width"
            android:title="Default Width"
            android:summary="Default sprite width"
            android:defaultValue="256"
            android:inputType="number" />
        <EditTextPreference
            android:key="default_height"
            android:title="Default Height"
            android:summary="Default sprite height"
            android:defaultValue="256"
            android:inputType="number" />
    </PreferenceCategory>

    <PreferenceCategory android:title="About">
        <Preference
            android:key="version"
            android:title="Version"
            android:summary="1.0.0" />
        <Preference
            android:key="license"
            android:title="Open Source Licenses"
            android:summary="View licenses" />
    </PreferenceCategory>

</PreferenceScreen>